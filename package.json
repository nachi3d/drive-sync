{
  "name": "@nachi3d/drive-sync",
  "version": "0.2.0",
  "description": "Single-active-device sync of an app snapshot to the user's Google Drive app folder (React Native / Expo).",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "README.md"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@react-native-google-signin/google-signin": ">=16.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.79.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-dom": "^19.3.0",
    "babel-jest": "~29.7.0",
    "jest": "~29.7.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  }
}
